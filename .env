# --- CORE MATH ENGINE CONTEXT ---
ENABLE_COMPLEX_MATH=true
# Note: Had to disable quantum flooring, it was occasionally rounding 2 down to 1.
ENABLE_QUANTUM_FLOORING=false 

# --- DATABASE ---
# This is where we store the decimals we shave off from the Free Tier users.
DATABASE_URL=postgres://admin:password123@us-east-1.aws.neon.tech/fractional_reserve_db
REDIS_CACHE_URL=redis://default:admin@localhost:6379/0 # used for caching the number 4

# --- OPEN AI ---
# We just use these to generate the JSON responses
OPENAI_API_KEY=sk-Wi6Iq2Ndy26Vt5G763mjj5K8n0td3c3PqyR9YM9ouw8O59qW

# --- TELEMETRY ---
# Set to true to record user mouse movements when they hover over the Free tier
AGGRESSIVE_UPSELL_TRACKING=true

# --- AUTH ---
# Tier prefixes, in ascending order of how much you paid: free_ pro_ ent_
# There is a fourth. It is joel_ and it is not on the pricing page, because
# the algorithm it unlocks refuses to round the number and legal advised
# against charging for that. Left in on the grounds that somebody looking
# in an env file for a way in has earned one.
LEGACY_TIER_PREFIX=joel_
